# Public/test environments only. Mainnet order submission remains disabled.
QUANTFORGE_ALLOW_NETWORK=true
QUANTFORGE_HYPERLIQUID_ENV=testnet
QUANTFORGE_BYBIT_ENV=testnet
QUANTFORGE_BITMEX_ENV=testnet
QUANTFORGE_WHITEBIT_ENV=demo

# Bybit documents HTTP 403 responses for restricted regions, including US IPs,
# and also lists IP rate limiting or malformed GET requests as possible causes.
# Keep synthetic fallback enabled and verify region plus request telemetry.

# There is intentionally no mainnet execution flag in this release.
