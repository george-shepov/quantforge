# Required for PostgreSQL. Generate a local value, for example:
# openssl rand -base64 32
POSTGRES_PASSWORD=

# Execution is denied unless every switch below is intentionally configured.
QUANTFORGE_TESTNET_EXECUTION_ENABLED=false
QUANTFORGE_EXECUTION_NETWORK=disabled
QUANTFORGE_SAFETY_TOKEN=
QUANTFORGE_TESTNET_MAX_NOTIONAL=100
HYPERLIQUID_TESTNET_PRIVATE_KEY=
HYPERLIQUID_TESTNET_ACCOUNT_ADDRESS=
